{
  "name": "english-quiz",
  "private": true,
  "version": "3.9.0",
  "type": "module",
  "description": "English cloze question bank for exam practice (pure PHP backend + vanilla JS frontend, no Node at runtime)",
  "scripts": {
    "dev:api": "php -S 127.0.0.1:9001 php/dev-router.php",
    "build:css": "tailwindcss -i styles/app.css -o php/assets/app.css --minify",
    "test:api": "node php/tests/api-test.mjs http://127.0.0.1:9001",
    "test:upgrade": "php php/tests/upgrade-test.php",
    "test:ui": "node php/tests/ui-test.mjs http://127.0.0.1:9002",
    "test:fingerprint": "node php/tests/fingerprint-js-test.mjs",
    "test:migration": "php php/tests/migration-test.php",
    "test:phase1": "node php/tests/bank-phase1-test.mjs http://127.0.0.1:9001",
    "test:phase2": "node php/tests/bank-phase2-test.mjs http://127.0.0.1:9001",
    "test:ai-preview": "node php/tests/ai-preview-test.mjs http://127.0.0.1:9002",
    "test:blueprint-ui": "node php/tests/blueprint-ui-test.mjs http://127.0.0.1:9002",
    "test:ai-preview-edit": "node php/tests/ai-preview-edit-test.mjs http://127.0.0.1:9002",
    "test:passage-entry": "node php/tests/passage-entry-test.mjs http://127.0.0.1:9002",
    "test:update-state": "php php/tests/update-state-test.php",
    "test:update-trigger": "node php/tests/update-trigger-test.mjs http://127.0.0.1:9002",
    "test:tag-collapse": "node php/tests/tag-collapse-test.mjs http://127.0.0.1:9002",
    "test:paper-delete": "node php/tests/paper-delete-test.mjs http://127.0.0.1:9002",
    "test:ai-passage": "node php/tests/ai-passage-collapse-test.mjs http://127.0.0.1:9002",
    "test:passage-leak": "node php/tests/passage-leak-test.mjs http://127.0.0.1:9002",
    "test:feedback": "node php/tests/feedback-smoke-test.mjs http://127.0.0.1:9002",
    "test:ai-auto-passage": "node php/tests/ai-auto-passage-test.mjs http://127.0.0.1:9002",
    "test:ai-unblank": "node php/tests/ai-passage-unblank-test.mjs http://127.0.0.1:9002",
    "test:ai-clean": "node php/tests/ai-clean-passage-test.mjs http://127.0.0.1:9002",
    "test:ai-top-passage": "node php/tests/ai-top-passage-test.mjs http://127.0.0.1:9002",
    "test:admin-buttons": "node php/tests/admin-buttons-test.mjs http://127.0.0.1:9002",
    "test:paper-passage": "node php/tests/paper-passage-test.mjs http://127.0.0.1:9002"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
